# ─────────────────────────────────────────────────────────────────────────────
# Platform environment variables
#
# Local:       nothing to copy. `pnpm crm --local` reads the Docker stack's
#              values from the Supabase CLI and injects them (CRM_ENV=local).
# Staging:     copy this file to apps/platform/.env.staging.local (git-ignored)
#              and fill in the STAGING project's values, then `pnpm crm --staging`.
# Production:  secrets live in Vercel → Project Settings → Environment Variables
#              (Production). They are never downloaded or committed. For a local
#              production build, keep an approved file OUTSIDE apps/platform and
#              run `pnpm crm --prod --credentials <path>`.
#
# Do NOT create apps/platform/.env, .env.local, .env.development,
# .env.development.local, .env.production or .env.production.local with
# Supabase variables — Next.js loads those
# automatically and `pnpm crm` refuses to run while they could override the
# selected environment.
#
# Every value below is cross-checked against CRM_ENV at startup
# (packages/config/src/environments.ts). Mismatches refuse to start.
# ─────────────────────────────────────────────────────────────────────────────

# Environment identity — required, no default: local | staging | production
#   local       → the Docker stack on 127.0.0.1 (injected by pnpm crm --local)
#   staging     → project gqkugpjmguufavbladxt
#   production  → project wvdwwmfzwvrniwpmiahu (Vercel Production only)
CRM_ENV=staging

# Supabase — all must belong to the CRM_ENV project above
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# sb_publishable_… key (or legacy anon JWT)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… key (or legacy service_role JWT) — server-only, never expose
SUPABASE_SERVICE_ROLE_KEY=
# Pooler: postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# The project ref in the username (or db.<ref>.supabase.co host) must match CRM_ENV.
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email
RESEND_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
